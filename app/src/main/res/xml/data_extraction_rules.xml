<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup (Android 12+) and device-to-device transfer rules.

    Excluded on purpose: the WebView cookie store (app_webview contains the
    browser session cookie database), MMKV preferences, the internal temp dir,
    and app caches. These hold session data the user never asked to move.
    Download history and user settings in Room/MMKV remain included.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="mmkv" />
        <exclude domain="file" path="tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="mmkv" />
        <exclude domain="file" path="tmp" />
    </device-transfer>
</data-extraction-rules>
